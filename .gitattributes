# Нормализация переводов строк: в репозитории всегда LF
* text=auto eol=lf

# Явно текстовые
*.php   text eol=lf
*.md    text eol=lf
*.sql   text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.json  text eol=lf
*.html  text eol=lf
*.csv   text eol=lf
*.xml   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.sh    text eol=lf

# Бинарные
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
